# ============================================
# AURORA SIGER
# Sistema de Telemetria Pré-Decolagem
# ============================================

print("============================================")
print("          AURORA SIGER")
print("     SISTEMA DE TELEMETRIA")
print("============================================")
print()

print("Digite os dados de telemetria da nave.")
print()

# Entrada dos dados
temperatura_interna = float(
    input("Temperatura interna (°C): ")
)

temperatura_externa = float(
    input("Temperatura externa (°C): ")
)

integridade_estrutural = int(
    input("Integridade estrutural (0 = falha / 1 = íntegra): ")
)

energia = float(
    input("Nível de energia (%): ")
)

pressao_tanques = float(
    input("Pressão dos tanques (%): ")
)

modulos_criticos = input(
    "Status dos módulos críticos (OK/WARN/FAIL): "
).upper()

# ============================================
# Exibição dos dados recebidos
# ============================================

print()
print("============================================")
print("       DADOS DE TELEMETRIA RECEBIDOS")
print("============================================")

print(f"Temperatura interna: {temperatura_interna:.1f} °C")
print(f"Temperatura externa: {temperatura_externa:.1f} °C")
print(f"Integridade estrutural: {integridade_estrutural}")
print(f"Nível de energia: {energia:.1f}%")
print(f"Pressão dos tanques: {pressao_tanques:.1f}%")
print(f"Módulos críticos: {modulos_criticos}")

print("============================================")
